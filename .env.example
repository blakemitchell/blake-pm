# Set this to your real HTTPS website address before deploying.
SITE_URL=https://blake.pm
# Optional local/test override. Production uses the public widget key embedded in the page.
PUBLIC_TURNSTILE_SITE_KEY=
# Optional local/test override for the public, domain-scoped production key.
PUBLIC_ECHOTHREAD_API_KEY=
# TURNSTILE_SECRET_KEY and DISCORD_WEBHOOK_URL are Worker secrets, not Astro variables.

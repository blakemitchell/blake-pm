    "@astrojs/solid-js": "^4.0.1",
    "@astrojs/tailwind": "^5.1.0",
    "@keystatic/astro": "^5.2.0",
    "@keystatic/core": "^0.6.9",
    "@tailwindcss/typography": "^0.5.10",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "astro": "^4.4.13",
    "clsx": "^2.1.0",
    "fuse.js": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4",

{
	"main": "dist/_worker.js/index.js",
	"name": "users-blake-code-astro-blake-pm",
  "compatibility_date": "2026-01-19",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
    "enabled": true
  }
  {
  "name": "blake-pm",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-01-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "blake.pm", "custom_domain": true },
    { "pattern": "www.blake.pm", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
}
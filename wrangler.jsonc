{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blake-pm",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-01-19",
  "compatibility_flags": ["nodejs_compat"],   // 👈 add this line
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "blake.pm", "custom_domain": true },
    { "pattern": "www.blake.pm", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}

---
import ArrowCard from "@components/ArrowCard"
import type { CollectionEntry } from "astro:content"
import { postDate, postSummary, postTitle } from "@lib/posts"
interface Props {
  postTypes?: string[]
  entry_name: string
  tags: string[]
  data: (CollectionEntry<'blog'> | CollectionEntry<'projects'>)[]
}
const { entry_name, tags, data, postTypes = [] } = Astro.props
---
<div class="collection-browser" data-collection>
  <div class="collection-controls" hidden>
    <label>Search {entry_name}<input data-search type="search" placeholder={`Search ${entry_name}`} autocomplete="off" /></label>
    {postTypes.length > 0 && <details class="collection-filter" data-filter>
      <summary><span>Post Type <span class="filter-selection" data-type-summary>All</span></span><small>Select multiple</small></summary>
      <fieldset class="filter-options">
        <legend class="sr-only">Post types</legend>
        <label><input type="checkbox" data-type-all checked />All types</label>
        {postTypes.map(type => <label><input type="checkbox" data-post-type={type} /><span class="capitalize">{type}</span></label>)}
      </fieldset>
    </details>}
    <details class="collection-filter" data-filter>
      <summary><span>Tags <span class="filter-selection" data-tag-summary>All</span></span><small>Select multiple</small></summary>
      <fieldset class="filter-options">
        <legend class="sr-only">Tags</legend>
        <label><input type="checkbox" data-tag-all checked />All tags</label>
        {tags.map(tag => <label><input type="checkbox" data-tag={tag.toLowerCase()} />{tag}</label>)}
      </fieldset>
    </details>
    <button type="button" data-clear hidden>Clear filters</button>
  </div>
  <div>
    <div class="collection-summary"><p aria-live="polite">Showing <span data-count>{data.length}</span> of {data.length} {entry_name}</p><button type="button" data-sort hidden>Newest first ↓</button></div>
    <ul class="space-y-3" data-entries>{data.map(entry => {
      const isPost = entry.collection === "blog"
      const title = isPost ? postTitle(entry) : entry.data.title
      const summary = isPost ? postSummary(entry) : entry.data.summary
      const date = isPost ? postDate(entry) : entry.data.date
      return <li data-entry data-post-type={isPost ? entry.data.post_type : undefined} data-search-text={`${title} ${summary ?? ""} ${entry.data.tags.join(' ')}`.toLowerCase()} data-tags={JSON.stringify(entry.data.tags.map(tag => tag.toLowerCase()))} data-date={date.getTime()}><ArrowCard entry={entry} /></li>
    })}</ul>
    <p data-empty hidden class="py-8">No matching {entry_name}. Try a different search or clear the filters.</p>
  </div>
</div>
<script is:inline src="/js/collection.js"></script>

---
const { url, caption = '' } = Astro.props
let source = '';
try { const parsed = new URL(url); if (parsed.protocol === 'https:') source = parsed.href; } catch { /* Invalid URLs leave the audio player omitted. */ }
---
<figure>{source && <audio controls preload="none" src={source} style="width:100%">Your browser does not support this audio.</audio>}{caption && <figcaption>{caption}</figcaption>}</figure>

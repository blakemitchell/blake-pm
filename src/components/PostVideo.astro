---
import { resolveVideo } from "@lib/video.js"

const { url, caption = '' } = Astro.props
const video = resolveVideo(url)
---
<figure class="post-video">
{video.kind === 'embed' ? <>
  <iframe class:list={['post-video-frame', { 'post-video-frame--portrait': video.layout === 'portrait' }]} src={video.embedUrl} title={video.title} loading="lazy" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" />
  <p class="post-video-source"><a href={video.sourceUrl} target="_blank" rel="noopener noreferrer">{video.sourceLabel}</a></p>
</> : video.kind === 'native' ? <video controls preload="metadata" src={video.sourceUrl} class="post-video-frame" title={video.title}>Your browser does not support this video.</video> : video.kind === 'fallback' ? <p class="post-video-fallback">Embedding is unavailable for this video. <a href={video.sourceUrl} target="_blank" rel="noopener noreferrer">{video.sourceLabel}</a>.</p> : <p class="post-video-fallback">A valid video link is unavailable.</p>}
{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .post-video-frame { display:block; width:100%; aspect-ratio:16 / 9; border:0; background:#000; }
  .post-video-frame--portrait { max-width:540px; aspect-ratio:9 / 16; margin-inline:auto; }
  .post-video-source, .post-video-fallback { margin-top:.65rem; color:var(--muted); font-size:.9rem; }
  .post-video-source a, .post-video-fallback a { color:var(--ink); text-underline-offset:3px; }
</style>

---
const { entry, Content } = Astro.props
const starts = entry.data.metadata.starts_at
---
<article><div class="event-card"><time datetime={starts.toISOString()}>{starts.toLocaleString("en-US", { dateStyle:"long", timeStyle:"short" })}</time>{entry.data.metadata.location && <p>{entry.data.metadata.location}</p>}</div><Content /></article>

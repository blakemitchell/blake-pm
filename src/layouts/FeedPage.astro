---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import PostFeed from "@components/PostFeed.astro"
const { title, description, types } = Astro.props
---
<PageLayout title={title} description={description}><TopLayout><div class="animate"><h1 class="page-heading">{title}</h1><p class="mt-1">{description}</p></div></TopLayout><BottomLayout><div class="animate"><PostFeed types={types} /></div></BottomLayout></PageLayout>

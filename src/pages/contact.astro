---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"

// Use a public form-service endpoint, never a recipient email or API secret.
const endpoint = import.meta.env.PUBLIC_CONTACT_FORM_URL?.trim()
const enabled = Boolean(endpoint && new URL(endpoint).protocol === "https:")
---
<PageLayout title="Contact" description="Get in touch with Blake Mitchell.">
  <TopLayout><h1 class="animate page-heading">Get in touch</h1></TopLayout>
  <BottomLayout>
    <div class="animate space-y-8">
      <p>Have a question or something you’d like to share? Leave me a message.</p>
      {!enabled && <p id="form-status" role="status" class="rounded-lg border border-black/15 dark:border-white/25 p-4 text-sm">This form isn’t accepting messages yet. Please check back soon.</p>}
      <form action={enabled ? endpoint : undefined} method="POST" class="space-y-6" aria-describedby={enabled ? undefined : "form-status"}>
        <fieldset disabled={!enabled} class="space-y-6">
          <div class="space-y-2">
            <label for="contact-name" class="block font-semibold">Your name</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="120" />
          </div>
          <div class="space-y-2">
            <label for="contact-email" class="block font-semibold">Your email</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="email-help" />
            <p id="email-help" class="text-sm">An address where I can reply to your message.</p>
          </div>
          <div class="space-y-2">
            <label for="contact-message" class="block font-semibold">Message</label>
            <textarea id="contact-message" name="message" rows="7" required minlength="10" maxlength="5000"></textarea>
          </div>
          <button type="submit" class="rounded px-5 py-3 bg-black text-white dark:bg-white dark:text-black hover:opacity-75 disabled:opacity-40 disabled:cursor-not-allowed">Send message</button>
        </fieldset>
      </form>
    </div>
  </BottomLayout>
</PageLayout>
<style>
  input, textarea { width: 100%; border: 1px solid rgb(128 128 128 / 45%); border-radius: .5rem; padding: .75rem; background: transparent; color: inherit; }
  input:focus-visible, textarea:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
</style>

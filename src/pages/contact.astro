---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"

// Turnstile site keys are public by design. Secrets stay in Cloudflare bindings.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() || "0x4AAAAAAE7GmaXoWDVXSoHJ"
const enabled = Boolean(turnstileSiteKey)
---
<PageLayout title="Contact" description="Get in touch with Blake Mitchell.">
  <TopLayout><h1 class="animate page-heading">Get in touch</h1></TopLayout>
  <BottomLayout>
    <div class="animate space-y-8">
      <p>Have a question or something you’d like to share? Leave me a message.</p>
      <p id="form-status" role="status" aria-live="polite" class:list={["form-status rounded-lg border p-4 text-sm", { "form-status-idle": enabled }]}>
        {enabled ? "Messages are stored so Blake can read and reply to them." : "This form isn’t accepting messages yet. Please check back soon."}
      </p>
      <form id="contact-form" action="/api/contact" method="POST" class="space-y-6" aria-describedby="form-status">
        <fieldset disabled={!enabled} class="space-y-6">
          <div class="contact-honeypot" aria-hidden="true">
            <label for="contact-website">Website</label>
            <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="space-y-2">
            <label for="contact-name" class="block font-semibold">Your name</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="120" />
          </div>
          <div class="space-y-2">
            <label for="contact-email" class="block font-semibold">Your email</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="email-help" />
            <p id="email-help" class="text-sm">An address where I can reply to your message.</p>
          </div>
          <div class="space-y-2">
            <label for="contact-message" class="block font-semibold">Message</label>
            <textarea id="contact-message" name="message" rows="7" required minlength="10" maxlength="5000"></textarea>
          </div>
          {enabled && <div id="contact-turnstile" data-sitekey={turnstileSiteKey}></div>}
          <button id="contact-submit" type="submit" class="rounded px-5 py-3 bg-black text-white dark:bg-white dark:text-black hover:opacity-75 disabled:opacity-40 disabled:cursor-not-allowed">Send message</button>
        </fieldset>
      </form>
    </div>
  </BottomLayout>
</PageLayout>
{enabled && <script is:inline>
  window.onContactTurnstileLoad = () => {
    const container = document.getElementById("contact-turnstile");
    if (!container || !window.turnstile || window.contactTurnstileWidgetId !== undefined) return;
    window.contactTurnstileWidgetId = window.turnstile.render(container, {
      sitekey: container.dataset.sitekey,
      action: "contact",
      theme: "auto",
    });
  };
</script>}
{enabled && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onContactTurnstileLoad&render=explicit" async defer></script>}
<script is:inline>
  (() => {
    const form = document.getElementById("contact-form");
    const submit = document.getElementById("contact-submit");
    const status = document.getElementById("form-status");
    if (!form || !submit || !status || form.querySelector("fieldset")?.disabled) return;

    form.addEventListener("submit", async event => {
      event.preventDefault();
      if (!form.reportValidity() || submit.disabled) return;
      submit.disabled = true;
      submit.textContent = "Sending…";
      status.className = "form-status rounded-lg border p-4 text-sm form-status-idle";
      status.textContent = "Sending your message…";
      try {
        const response = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { accept: "application/json" } });
        const result = await response.json().catch(() => null);
        if (!response.ok || result?.ok !== true) throw new Error("Submission failed");
        form.reset();
        window.turnstile?.reset(window.contactTurnstileWidgetId);
        status.className = "form-status rounded-lg border p-4 text-sm form-status-success";
        status.textContent = "Thanks. Your message was received.";
      } catch {
        window.turnstile?.reset(window.contactTurnstileWidgetId);
        status.className = "form-status rounded-lg border p-4 text-sm form-status-error";
        status.textContent = "Something went wrong. Please try again in a moment.";
      } finally {
        submit.disabled = false;
        submit.textContent = "Send message";
      }
    });
  })();
</script>
<style>
  input, textarea { width: 100%; border: 1px solid rgb(128 128 128 / 45%); border-radius: .5rem; padding: .75rem; background: transparent; color: inherit; }
  input:focus-visible, textarea:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .contact-honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .form-status-idle { border-color: color-mix(in srgb, var(--ink) 18%, transparent); }
  .form-status-success { border-color: color-mix(in srgb, #56c98f 65%, var(--ink)); background: color-mix(in srgb, #56c98f 9%, transparent); color: var(--ink); }
  .form-status-error { border-color: color-mix(in srgb, #e57676 65%, var(--ink)); background: color-mix(in srgb, #e57676 9%, transparent); color: var(--ink); }
</style>

---
import { getEntry } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import { buildVersion } from "@lib/build-version"

const page = await getEntry("pages", "about-this-site")
if (!page) throw new Error("About This Site content is missing")
const { Content } = await page.render()
---
<PageLayout title={page.data.title} description={page.data.description}>
  <section class="mx-auto max-w-screen-md px-5 pt-32 pb-20"><article>
    <h1 class="page-heading">{page.data.title}</h1>
    <Content />
    <p class="site-build-version">Current build: ver. {buildVersion}</p>
  </article></section>
</PageLayout>

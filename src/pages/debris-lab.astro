---
import PageLayout from "@layouts/PageLayout.astro"
---

<PageLayout title="Debris Lab" description="A private visual catalog of the objects that cross the home-page sky." noindex={true}>
  <section class="debris-lab">
    <h1 class="page-heading">Debris Lab</h1>
    <p>This unlinked page shows every object used by the home-page debris animation. On the home page, open Atmosphere → Options, leave Motion on, and move Debris to its highest setting. One randomly selected object can appear at a time; at maximum frequency, a new traveler is scheduled roughly every 3–5 seconds.</p>
    <div id="debris-grid" class="debris-grid" aria-live="polite"></div>
    <noscript><p>JavaScript must be enabled to display the shared debris catalog.</p></noscript>
  </section>
  <script is:inline src="/js/debris-catalog.js"></script>
  <script is:inline>
    (() => {
      const grid = document.getElementById("debris-grid")
      const debris = window.blakeDebris || []
      if (!grid) return

      for (const item of debris) {
        const card = document.createElement("article")
        card.className = "debris-card"

        const preview = document.createElement("div")
        preview.className = "debris-preview"
        preview.setAttribute("aria-hidden", "true")
        preview.style.setProperty("--debris-preview-size", `${Math.round(item.max * 1.25)}px`)
        preview.innerHTML = item.svg

        const copy = document.createElement("div")
        const heading = document.createElement("h2")
        heading.textContent = item.name
        const description = document.createElement("p")
        description.textContent = item.description
        const size = document.createElement("span")
        size.className = "debris-size"
        size.textContent = `Animated size: ${item.min}–${item.max}px`

        copy.append(heading, description, size)
        card.append(preview, copy)
        grid.append(card)
      }
    })()
  </script>
</PageLayout>

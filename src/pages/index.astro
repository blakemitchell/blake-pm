---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard"
import { SITE } from "@consts"

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,3)

---

<PageLayout title="Home" description={SITE.DESCRIPTION}>

  <div id="ambient-sky" aria-hidden="true"><div id="star-field"></div></div>
  <script is:inline src="/js/bg.js"></script>

  <!-- HERO -->
  <section class="hero relative w-full">
    <div id="planetcont" aria-hidden="true">
      <svg class="aurora-horizon" viewBox="0 0 1440 440" preserveAspectRatio="none">
        <defs><linearGradient id="horizon-colors"><stop stop-color="var(--glow)" stop-opacity="0"/><stop offset=".25" stop-color="var(--glow)"/><stop offset=".5" stop-color="var(--ribbon)"/><stop offset=".75" stop-color="var(--accent)"/><stop offset="1" stop-color="var(--glow)" stop-opacity="0"/></linearGradient></defs>
        <path class="horizon-ground" d="M-80 150 Q720 -100 1520 150 V440 H-80Z" />
        <g class="aurora-ribbons" fill="none" stroke="url(#horizon-colors)">
          <path class="ribbon-halo" d="M-80 150 Q720 -100 1520 150" />
          <path class="ribbon-one" d="M-80 145 C130 54 230 105 390 40 S620 55 760 20 S1100 35 1520 145" />
          <path class="ribbon-two" d="M-80 148 C210 60 280 47 430 38 S650 -4 820 28 S1080 7 1520 150" />
          <path class="ribbon-rim" d="M-80 150 Q720 -100 1520 150" />
        </g>
      </svg>
    </div>
    <div class="animate absolute h-full w-full flex items-center justify-center">
      <div class='relative w-full h-full flex items-center justify-center'>
        <div class='p-5 text-center'>
          <p class='animated text-lg md:text-xl lg:text-2xl font-semibold opacity-75'>
            Hello, I’m
          </p>
          <p class='animated text-2xl md:text-3xl lg:text-4xl font-bold uppercase text-black dark:text-white'>
            {SITE.AUTHOR}
          </p>
          <p class='animated text-sm md:text-base lg:text-lg opacity-75'>
            A place for notes, ideas, and what comes next.
          </p>
          <div id="ctaButtons" class='animated flex flex-wrap gap-4 justify-center mt-5'>
            <a href='/blog' class='hero-action'>
              Read my blog
            </a>
            <a href='/about' class='hero-action'>
              About me
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="relative bg-white dark:bg-black">
    <div class="mx-auto max-w-screen-md p-5 space-y-12 pb-16">

      <!-- About Section -->
      <section class="animate">
        <article>
          <p>Welcome. I’m Blake, and this is my little corner of the web.</p>
          <p>I’m still shaping what this space will become. For now, it’s a home for writing, ideas, and the things I want to share along the way.</p>
        </article>
      </section>

      <!-- Blog Preview Section -->
      <section class="animate">
        <div class="space-y-4">
          <div class="flex justify-between">
            <p class="font-semibold text-black dark:text-white">
              Recent posts
            </p>
            <a href="/blog" class="w-fit col-span-3 group flex gap-1 items-center underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend">
              <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                All posts
              </span>
            </a>
          </div>
          <ul class="space-y-4">
            {posts.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))}
          </ul>
        </div>
      </section>

    </div>
  </div>
</PageLayout>

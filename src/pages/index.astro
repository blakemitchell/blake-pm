---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard"
import { SITE } from "@consts"
import { postDate, validatePostBody } from "@lib/posts"

const posts = (await getCollection("blog"))
  .map(validatePostBody)
  .filter(post => !post.data.draft)
  .filter(post => ["article", "review"].includes(post.data.post_type))
  .sort((a, b) => postDate(b).getTime() - postDate(a).getTime())
  .slice(0,3)

---

<PageLayout title="Home" description={SITE.DESCRIPTION}>

  <div id="ambient-sky" aria-hidden="true"><div id="star-field"></div></div>
  <script is:inline src="/js/debris-catalog.js"></script>
  <script is:inline src="/js/bg.js"></script>

  <!-- HERO -->
  <section class="hero relative w-full">
    <div id="planetcont" aria-hidden="true">
      <svg class="aurora-horizon" viewBox="0 0 1600 700" preserveAspectRatio="none">
        <defs>
          <linearGradient id="horizon-colors" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="var(--glow)" stop-opacity="0" />
            <stop offset="18%" stop-color="var(--glow)" stop-opacity="0.35" />
            <stop offset="38%" stop-color="var(--ribbon)" stop-opacity="0.8" />
            <stop offset="62%" stop-color="var(--accent)" stop-opacity="0.85" />
            <stop offset="82%" stop-color="var(--glow)" stop-opacity="0.35" />
            <stop offset="100%" stop-color="var(--glow)" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="aurora-celestial" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="var(--accent)" stop-opacity="0" />
            <stop offset="22%" stop-color="var(--accent)" stop-opacity="0.5" />
            <stop offset="50%" stop-color="var(--glow)" stop-opacity="0.7" />
            <stop offset="78%" stop-color="var(--ribbon)" stop-opacity="0.5" />
            <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="aurora-rim-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="var(--glow)" stop-opacity="0.2" />
            <stop offset="20%" stop-color="var(--glow)" stop-opacity="0.75" />
            <stop offset="50%" stop-color="var(--accent)" stop-opacity="0.95" />
            <stop offset="80%" stop-color="var(--ribbon)" stop-opacity="0.75" />
            <stop offset="100%" stop-color="var(--glow)" stop-opacity="0.2" />
          </linearGradient>
        </defs>
        <path class="horizon-ground" d="M-500 505 Q800 20 2100 505 V700 H-500Z" />
        <g class="aurora-ribbons" fill="none">
          <path class="ribbon-halo" d="M-500 505 Q800 20 2100 505" stroke="url(#horizon-colors)" />
          <path class="ribbon-curtain" d="M-500 492 Q800 -6 2100 492" stroke="url(#aurora-celestial)" />
          <path class="ribbon-one" d="M-500 496 Q800 4 2100 496" stroke="url(#horizon-colors)" />
          <path class="ribbon-two" d="M-500 501 Q800 13 2100 501" stroke="url(#aurora-celestial)" />
          <path class="horizon-rim" d="M-500 505 Q800 20 2100 505" stroke="url(#aurora-rim-gradient)" />
        </g>
      </svg>
    </div>
    <div class="animate absolute h-full w-full flex items-center justify-center">
      <div class='hero-copy-inner relative w-full h-full flex items-center justify-center'>
        <div class='p-5 text-center'>
          <p class='animated text-lg md:text-xl lg:text-2xl font-semibold opacity-75'>
            Field notes from
          </p>
          <p class='animated text-2xl md:text-3xl lg:text-4xl font-bold uppercase text-black dark:text-white'>
            {SITE.AUTHOR}
          </p>
          <p class='animated text-sm md:text-base lg:text-lg opacity-75'>
            Curiosity, technology, and whatever deserves a closer look.
          </p>
          <!-- Home-page calls to action are intentionally paused while this introduction evolves.
          <div id="ctaButtons" class='animated flex flex-wrap gap-4 justify-center mt-5'>
            <a href='/blog' class='hero-action'>
              Read my blog
            </a>
            <a href='/about' class='hero-action'>
              About me
            </a>
          </div>
          -->
        </div>
      </div>
    </div>
  </section>

  <div class="relative bg-white dark:bg-black">
    <div class="mx-auto max-w-screen-md p-5 space-y-12 pb-16">

      <!-- About Section -->
      <section class="animate home-about">
        <div class="home-vignette" aria-hidden="true">
          <img src="/images/site/field-notes-journal.webp" alt="" width="1000" height="667" />
        </div>
        <article>
          <p>I’m Blake. This is where I collect observations, experiments, and ideas that are still taking shape.</p>
          <p>Expect writing about technology, work, culture, and whatever else pulls me into its orbit.</p>
        </article>
      </section>

      <!-- Blog Preview Section -->
      <section class="animate">
        <div class="space-y-4">
          <div class="flex justify-between">
            <p class="font-semibold text-black dark:text-white">
              Recent Posts
            </p>
            <a href="/blog" class="w-fit col-span-3 group flex gap-1 items-center underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend">
              <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                All Posts
              </span>
            </a>
          </div>
          <ul class="space-y-4">
            {posts.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))}
          </ul>
        </div>
      </section>

    </div>
  </div>
</PageLayout>
